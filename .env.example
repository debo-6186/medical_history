# Shared login PIN (use at least 6 digits)
APP_PIN=change-me-6-digits

SESSION_TTL_HOURS=24
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=gemma4:26b
OCR_MODEL=qwen3-vl:8b
EMBED_MODEL=nomic-embed-text
# Embedding dimension must match EMBED_MODEL (nomic-embed-text = 768). Fixed into
# the ObjectBox HNSW index, so changing it requires rebuilding the store.
EMBED_DIM=768
# ObjectBox vector distance: cosine | euclidean | dot_product. Must match the
# Android entity. Baked into the HNSW index — changing it requires a rebuild.
VECTOR_DISTANCE=cosine
ANALYSIS_NUM_CTX=32768
CHAT_NUM_CTX=8192
MAX_UPLOAD_MB=25q

# --- Reminders / Google Calendar -------------------------------------------
# Local sqlite store of drafted reminders (defaults under rag_db/).
# REMINDERS_DB_PATH=./rag_db/reminders.db
# OAuth "Desktop app" client secrets from Google Cloud Console (Calendar API
# enabled), and the token written after the one-time consent. Keep both private.
# GOOGLE_CREDENTIALS_PATH=./rag_db/google_credentials.json
# GOOGLE_TOKEN_PATH=./rag_db/google_token.json
# GOOGLE_CALENDAR_ID=primary
# Privacy: medication reminder titles are truncated to this many characters
# before being sent to Google.
# MED_TITLE_PREFIX_LEN=4
